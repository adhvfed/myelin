documentsize 24x24
defaults
  fill none
  stroke currentColor
  stroke-width 2
  stroke-linecap round
  stroke-linejoin round
shape v1 template=path
  addpoint a at=9,4
  addpoint b at=7,20
place a1 shape=v1 at=0,0
shape v2 template=path
  addpoint a at=17,4
  addpoint b at=15,20
place a2 shape=v2 at=0,0
shape h1 template=path
  addpoint a at=4,9
  addpoint b at=20,9
place b1 shape=h1 at=0,0
shape h2 template=path
  addpoint a at=4,15
  addpoint b at=20,15
place b2 shape=h2 at=0,0
