documentsize 24x24
defaults
  fill none
  stroke $ink
  stroke-width 2
  stroke-linecap round
  stroke-linejoin round
palette
  ink #ff00ff
shape back template=path
  addpoint a at=10,5
  addpoint b at=19,5 mode=catmull-rom
  addpoint c at=20,6 mode=catmull-rom
  addpoint d at=20,11 mode=catmull-rom
  addpoint e at=19,12 mode=catmull-rom
  addpoint f at=17,12
place bk shape=back at=0,0
shape front template=path
  addpoint a at=8,19
  addpoint b at=8,16
  addpoint c at=5,16 mode=catmull-rom
  addpoint d at=4,15 mode=catmull-rom
  addpoint e at=4,10 mode=catmull-rom
  addpoint f at=5,9 mode=catmull-rom
  addpoint g at=14,9 mode=catmull-rom
  addpoint h at=15,10 mode=catmull-rom
  addpoint i at=15,15 mode=catmull-rom
  addpoint j at=14,16 mode=catmull-rom
  addpoint k at=11,16
  close
place fr shape=front at=0,0
