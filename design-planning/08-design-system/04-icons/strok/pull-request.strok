documentsize 24x24
defaults
  fill none
  stroke currentColor
  stroke-width 2
  stroke-linecap round
  stroke-linejoin round
shape leftrail template=path
  addpoint a at=7,8
  addpoint b at=7,16
place lr shape=leftrail at=0,0
shape rightrail template=path
  addpoint a at=17,8
  addpoint b at=17,16
place rr shape=rightrail at=0,0
shape arrowhead template=path
  addpoint a at=14,11
  addpoint b at=17,8
  addpoint c at=20,11
place ah shape=arrowhead at=0,0
shape ntop template=ellipse
place n1 shape=ntop at=4,4 size=6x6
shape nbottom template=ellipse
place n2 shape=nbottom at=4,14 size=6x6
shape nright template=ellipse
place n3 shape=nright at=14,14 size=6x6
