documentsize 24x24
defaults
  fill none
  stroke $ink
  stroke-width 2
  stroke-linecap round
  stroke-linejoin round
palette
  ink #ff00ff
shape leftrail template=path
  addpoint a at=6,8
  addpoint b at=6,16
place lr shape=leftrail at=0,0
shape connector template=path
  addpoint a at=18,16
  addpoint b at=18,11 mode=catmull-rom
  addpoint c at=15,8 mode=catmull-rom
  addpoint d at=9,8
place cn shape=connector at=0,0
shape arrowhead template=path
  addpoint a at=11,5
  addpoint b at=8,8
  addpoint c at=11,11
place ah shape=arrowhead at=0,0
shape ntop template=ellipse
place n1 shape=ntop at=3,3 size=6x6
shape nbottom template=ellipse
place n2 shape=nbottom at=3,17 size=6x6
shape nright template=ellipse
place n3 shape=nright at=15,17 size=6x6
