documentsize 24x24
defaults
  fill none
  stroke $ink
  stroke-width 2
  stroke-linecap round
  stroke-linejoin round
palette
  ink #ff00ff
shape body template=rectangle
  round-corners 2
place b1 shape=body at=5,11 size=14x9
shape shackle template=path
  addpoint a at=8,11
  addpoint b at=8,7 mode=catmull-rom
  addpoint c at=12,5 mode=catmull-rom
  addpoint d at=16,7 mode=catmull-rom
  addpoint e at=16,11 mode=catmull-rom
place s1 shape=shackle at=0,0
