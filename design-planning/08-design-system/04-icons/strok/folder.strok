documentsize 24x24
defaults
  fill none
  stroke $ink
  stroke-width 2
  stroke-linecap round
  stroke-linejoin round
palette
  ink #ff00ff
shape body template=path
  addpoint a at=3,7
  addpoint b at=9,7
  addpoint c at=11,9
  addpoint d at=21,9
  addpoint e at=21,19
  addpoint f at=3,19
  close
  round-corners 1
place b1 shape=body at=0,0
