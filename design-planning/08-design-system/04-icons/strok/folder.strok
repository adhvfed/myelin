# @meaning Folder / space
# @tags folder, space, directory, group
documentsize 24x24
defaults
  fill none
  stroke currentColor
  stroke-width 2
  stroke-linecap round
  stroke-linejoin round
shape body template=path
  addpoint a at=4,18
  addpoint b at=4,7
  addpoint c at=9,7
  addpoint d at=9,9
  addpoint e at=20,9
  addpoint f at=20,18
  close
  round-corners 1.5
place b1 shape=body at=0,0
