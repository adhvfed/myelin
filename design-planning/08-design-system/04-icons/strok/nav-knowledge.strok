documentsize 24x24
defaults
  fill none
  stroke $ink
  stroke-width 2
  stroke-linecap round
  stroke-linejoin round
palette
  ink #ff00ff
shape spine template=path
  addpoint a at=12,5
  addpoint b at=12,19
place s1 shape=spine at=0,0
shape leftpage template=path
  addpoint a at=12,5
  addpoint b at=7,4
  addpoint c at=4,5
  addpoint d at=4,18
  addpoint e at=7,17
  addpoint f at=12,18
place lp shape=leftpage at=0,0
shape rightpage template=path
  addpoint a at=12,5
  addpoint b at=17,4
  addpoint c at=20,5
  addpoint d at=20,18
  addpoint e at=17,17
  addpoint f at=12,18
place rp shape=rightpage at=0,0
