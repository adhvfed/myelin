documentsize 24x24
defaults
  fill none
  stroke $ink
  stroke-width 2
  stroke-linecap round
  stroke-linejoin round
palette
  ink #ff00ff
shape left template=path
  addpoint a at=9,7
  addpoint b at=4,12
  addpoint c at=9,17
shape right template=path
  addpoint a at=15,7
  addpoint b at=20,12
  addpoint c at=15,17
place left1 shape=left at=0,0
place right1 shape=right at=0,0
