documentsize 24x24
defaults
  fill none
  stroke currentColor
  stroke-width 2
  stroke-linecap round
  stroke-linejoin round
shape body template=rectangle
  round-corners 3
place b1 shape=body at=4,5 size=16x11
shape tail template=path
  addpoint a at=8,16
  addpoint b at=7,20
  addpoint c at=11,16
place t1 shape=tail at=0,0
