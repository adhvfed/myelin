documentsize 24x24
defaults
  fill none
  stroke $ink
  stroke-width 2
  stroke-linecap round
  stroke-linejoin round
palette
  ink #ff00ff
shape bubble template=path
  addpoint a at=6,19
  addpoint b at=6,16
  addpoint c at=5,16 mode=catmull-rom
  addpoint d at=4,15 mode=catmull-rom
  addpoint e at=4,7 mode=catmull-rom
  addpoint f at=5,6 mode=catmull-rom
  addpoint g at=19,6 mode=catmull-rom
  addpoint h at=20,7 mode=catmull-rom
  addpoint i at=20,15 mode=catmull-rom
  addpoint j at=19,16 mode=catmull-rom
  addpoint k at=10,16
  close
place b1 shape=bubble at=0,0
