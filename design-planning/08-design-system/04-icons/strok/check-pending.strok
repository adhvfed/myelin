documentsize 24x24
defaults
  fill none
  stroke $ink
  stroke-width 2
  stroke-linecap round
  stroke-linejoin round
palette
  ink #ff00ff
shape ring template=ellipse
place r1 shape=ring at=4,4 size=16x16
shape hand template=path
  addpoint a at=12,8
  addpoint b at=12,12
  addpoint c at=15,12
place h1 shape=hand at=0,0
