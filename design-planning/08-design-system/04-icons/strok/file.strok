documentsize 24x24
defaults
  fill none
  stroke $ink
  stroke-width 2
  stroke-linecap round
  stroke-linejoin round
palette
  ink #ff00ff
shape body template=path
  addpoint a at=6,3
  addpoint b at=14,3
  addpoint c at=19,8
  addpoint d at=19,21
  addpoint e at=6,21
  close
place b1 shape=body at=0,0
shape fold template=path
  addpoint a at=14,3
  addpoint b at=14,8
  addpoint c at=19,8
place f1 shape=fold at=0,0
