documentsize 24x24
defaults
  fill none
  stroke $ink
  stroke-width 2
  stroke-linecap round
  stroke-linejoin round
palette
  ink #ff00ff
shape ring template=ellipse
place r1 shape=ring at=4,4 size=16x16
shape l1 template=path
  addpoint a at=9,9
  addpoint b at=15,15
place a1 shape=l1 at=0,0
shape l2 template=path
  addpoint a at=15,9
  addpoint b at=9,15
place a2 shape=l2 at=0,0
