# @meaning CI subsystem (circle + play)
# @tags nav, ci, build, pipeline, subsystem
documentsize 24x24
defaults
  fill none
  stroke currentColor
  stroke-width 2
  stroke-linecap round
  stroke-linejoin round
shape ring template=ellipse
place r1 shape=ring at=3,3 size=18x18
shape play template=path
  addpoint a at=10,8
  addpoint b at=16,12
  addpoint c at=10,16
  close
place p1 shape=play at=0,0
