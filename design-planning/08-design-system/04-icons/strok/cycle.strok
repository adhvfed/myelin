documentsize 24x24
defaults
  fill none
  stroke $ink
  stroke-width 2
  stroke-linecap round
  stroke-linejoin round
palette
  ink #ff00ff
shape ring template=path
  addpoint a at=14,4
  addpoint b at=19,7 mode=catmull-rom
  addpoint c at=20,12 mode=catmull-rom
  addpoint d at=17,17 mode=catmull-rom
  addpoint e at=12,19 mode=catmull-rom
  addpoint f at=6,17 mode=catmull-rom
  addpoint g at=4,12 mode=catmull-rom
  addpoint h at=6,7 mode=catmull-rom
  addpoint i at=10,5
place r1 shape=ring at=0,0
shape arrowhead template=path
  addpoint a at=11,8
  addpoint b at=14,4
  addpoint c at=11,3
place ah shape=arrowhead at=0,0
