documentsize 24x24
defaults
  fill none
  stroke $ink
  stroke-width 2
  stroke-linecap round
  stroke-linejoin round
palette
  ink #ff00ff
shape ring template=ellipse
place r1 shape=ring at=4,4 size=16x16
shape arrow template=path
  addpoint a at=16,4
  addpoint b at=20,4
  addpoint c at=20,8
place ar shape=arrow at=0,0
