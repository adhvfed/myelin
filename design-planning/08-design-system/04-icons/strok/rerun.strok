documentsize 24x24
defaults
  fill none
  stroke $ink
  stroke-width 2
  stroke-linecap round
  stroke-linejoin round
palette
  ink #ff00ff
shape arc template=path
  addpoint a at=15,4.5
  addpoint b at=20,12 mode=arc rx=8 ry=8
  addpoint c at=12,20 mode=arc rx=8 ry=8
  addpoint d at=4,12 mode=arc rx=8 ry=8
  addpoint e at=10,5 mode=arc rx=8 ry=8
place a1 shape=arc at=0,0
shape arrowhead template=path
  addpoint a at=19,6
  addpoint b at=15,4.5
  addpoint c at=14,9
place ah shape=arrowhead at=0,0
