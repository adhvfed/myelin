documentsize 24x24
defaults
  fill none
  stroke $ink
  stroke-width 2
  stroke-linecap round
  stroke-linejoin round
palette
  ink #ff00ff
shape arc template=path
  addpoint a at=19,9
  addpoint b at=17,5 mode=catmull-rom
  addpoint c at=12,4 mode=catmull-rom
  addpoint d at=6,7 mode=catmull-rom
  addpoint e at=5,13 mode=catmull-rom
  addpoint f at=9,18 mode=catmull-rom
  addpoint g at=15,18 mode=catmull-rom
  addpoint h at=19,14 mode=catmull-rom
place a1 shape=arc at=0,0
shape arrowhead template=path
  addpoint a at=14,9
  addpoint b at=19,9
  addpoint c at=19,4
place ah shape=arrowhead at=0,0
