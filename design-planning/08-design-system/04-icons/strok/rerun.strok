# @meaning Re-run a check / job (clockwise circular arrow)
# @tags ci, rerun, retry, refresh, circular-arrow
documentsize 24x24
defaults
  fill none
  stroke currentColor
  stroke-width 2
  stroke-linecap round
  stroke-linejoin round
shape arc template=path
  addpoint a at=14.74,4.48
  addpoint b at=20,12 mode=arc rx=8 ry=8 bulge=right
  addpoint c at=12,20 mode=arc rx=8 ry=8 bulge=right
  addpoint d at=4,12 mode=arc rx=8 ry=8 bulge=right
  addpoint e at=9.26,4.48 mode=arc rx=8 ry=8 bulge=right
place a1 shape=arc at=0,0
shape arrowhead template=path
  addpoint a at=5.7,2.25
  addpoint b at=9.26,4.48
  addpoint c at=7.96,8.47
place ah shape=arrowhead at=0,0
