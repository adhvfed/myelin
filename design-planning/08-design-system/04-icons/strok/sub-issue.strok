documentsize 24x24
defaults
  fill none
  stroke currentColor
  stroke-width 2
  stroke-linecap round
  stroke-linejoin round
shape elbow template=path
  addpoint a at=7,4
  addpoint b at=7,14
  addpoint c at=13,14
place e1 shape=elbow at=0,0
shape ring template=ellipse
place r1 shape=ring at=14,11 size=6x6
