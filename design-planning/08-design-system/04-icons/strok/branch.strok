documentsize 24x24
defaults
  fill none
  stroke currentColor
  stroke-width 2
  stroke-linecap round
  stroke-linejoin round
shape rail template=path
  addpoint a at=7,7
  addpoint b at=7,17
place r1 shape=rail at=0,0
shape diverge template=path
  addpoint a at=7,12
  addpoint b at=17,10 mode=arc rx=11 ry=11
place d1 shape=diverge at=0,0
shape ntop template=ellipse
place n1 shape=ntop at=4,4 size=6x6
shape nbottom template=ellipse
place n2 shape=nbottom at=4,14 size=6x6
shape nbranch template=ellipse
place n3 shape=nbranch at=14,4 size=6x6
