{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Finalist B — Workshop. DTCG tokens (primitive -> semantic -> component). Warm/calm/editorial, distinct-per-surface, neutral-led + one restrained terracotta accent. The focus-ring/primary-action token is a DERIVED AA-safe blue, deliberately NOT the brand accent (focus token != identity token). Light + dark. All contrast numbers measured (see README G1).",
  "primitive": {
    "$description": "Tier 1 — raw values, no semantics. Warm-grey/cream ramp, never pure #fff/#000.",
    "color": {
      "cream": {
        "0":  { "$type": "color", "$value": "#FFFDF8" },
        "50": { "$type": "color", "$value": "#FBF8F2" },
        "100":{ "$type": "color", "$value": "#F1EADD" },
        "200":{ "$type": "color", "$value": "#E9E1D2" },
        "300":{ "$type": "color", "$value": "#E3DACB" },
        "400":{ "$type": "color", "$value": "#CDC2AE" }
      },
      "ink": {
        "900":{ "$type": "color", "$value": "#211E18" },
        "700":{ "$type": "color", "$value": "#3A352C" },
        "600":{ "$type": "color", "$value": "#5C5345" },
        "500":{ "$type": "color", "$value": "#6E6456" }
      },
      "warmgrey-dark": {
        "$description": "dark-mode warm ramp",
        "bg":   { "$type": "color", "$value": "#1A1813" },
        "panel":{ "$type": "color", "$value": "#211E18" },
        "raise":{ "$type": "color", "$value": "#272219" },
        "line": { "$type": "color", "$value": "#38332A" },
        "line2":{ "$type": "color", "$value": "#4A4234" },
        "ink":  { "$type": "color", "$value": "#ECE6D9" },
        "t2":   { "$type": "color", "$value": "#B3A892" },
        "t3":   { "$type": "color", "$value": "#968B77" }
      },
      "terracotta": {
        "$description": "the one brand accent — warm, restrained",
        "light": { "$type": "color", "$value": "#9C4A21" },
        "dark":  { "$type": "color", "$value": "#E08A53" }
      },
      "blue": {
        "$description": "functional + derived AA-safe focus hue (NOT the identity accent)",
        "light": { "$type": "color", "$value": "#1C5DA8" },
        "dark":  { "$type": "color", "$value": "#6BA8E8" }
      },
      "green":  { "light": { "$type": "color", "$value": "#2E6B43" }, "dark": { "$type": "color", "$value": "#6FB585" } },
      "amber":  { "light": { "$type": "color", "$value": "#8A5A12" }, "dark": { "$type": "color", "$value": "#D6A24A" } },
      "red":    { "light": { "$type": "color", "$value": "#A63A28" }, "dark": { "$type": "color", "$value": "#E0775F" } },
      "olive":  { "light": { "$type": "color", "$value": "#4F5E2E" }, "dark": { "$type": "color", "$value": "#A9BE7A" } },
      "indigo": {
        "$description": "reserved agent token — non-alarming, never a status colour",
        "light": { "$type": "color", "$value": "#4B4A8C" },
        "dark":  { "$type": "color", "$value": "#9D9BE0" },
        "wash-light": { "$type": "color", "$value": "#EEEDF7" },
        "wash-dark":  { "$type": "color", "$value": "#26243A" }
      },
      "pure": { "white": { "$type": "color", "$value": "#FFFFFF" }, "near-black": { "$type": "color", "$value": "#16140F" } }
    },
    "dimension": {
      "0": { "$type": "dimension", "$value": "0px" },
      "1": { "$type": "dimension", "$value": "4px" },
      "2": { "$type": "dimension", "$value": "8px" },
      "3": { "$type": "dimension", "$value": "12px" },
      "4": { "$type": "dimension", "$value": "16px" },
      "5": { "$type": "dimension", "$value": "20px" },
      "6": { "$type": "dimension", "$value": "24px" },
      "8": { "$type": "dimension", "$value": "32px" },
      "measure": { "$type": "dimension", "$value": "66ch" }
    },
    "radius": {
      "sm": { "$type": "dimension", "$value": "6px" },
      "md": { "$type": "dimension", "$value": "10px" },
      "lg": { "$type": "dimension", "$value": "14px" },
      "pill": { "$type": "dimension", "$value": "999px" }
    },
    "duration": {
      "fast":   { "$type": "duration", "$value": "120ms" },
      "normal": { "$type": "duration", "$value": "200ms" }
    },
    "font": {
      "serif": { "$type": "fontFamily", "$value": ["Fraunces", "Georgia", "serif"] },
      "sans":  { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] },
      "mono":  { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "Menlo", "monospace"] }
    }
  },

  "semantic": {
    "$description": "Tier 2 — role-named, theme-switchable. Light values shown; dark overrides documented in tokens.css [data-theme=dark].",
    "color": {
      "surface":      { "$type": "color", "$value": "{primitive.color.cream.50}" },
      "surface-raise":{ "$type": "color", "$value": "{primitive.color.cream.0}" },
      "surface-sunk": { "$type": "color", "$value": "{primitive.color.cream.100}" },
      "line":         { "$type": "color", "$value": "{primitive.color.cream.300}" },
      "line-strong":  { "$type": "color", "$value": "{primitive.color.cream.400}" },
      "text":         { "$type": "color", "$value": "{primitive.color.ink.900}" },
      "text-2":       { "$type": "color", "$value": "{primitive.color.ink.600}" },
      "text-3":       { "$type": "color", "$value": "{primitive.color.ink.500}" },
      "accent":       { "$type": "color", "$value": "{primitive.color.terracotta.light}", "$description": "identity ONLY — never used as the focus/primary-action ring" },
      "on-accent":    { "$type": "color", "$value": "{primitive.color.pure.white}" },
      "focus":        { "$type": "color", "$value": "{primitive.color.blue.light}", "$description": "DERIVED AA-safe focus + primary-action; deliberately NOT the accent" },
      "on-focus":     { "$type": "color", "$value": "{primitive.color.pure.white}" },
      "status-ok":    { "$type": "color", "$value": "{primitive.color.green.light}" },
      "status-warn":  { "$type": "color", "$value": "{primitive.color.amber.light}" },
      "status-danger":{ "$type": "color", "$value": "{primitive.color.red.light}" },
      "link":         { "$type": "color", "$value": "{primitive.color.olive.light}" },
      "agent":        { "$type": "color", "$value": "{primitive.color.indigo.light}" },
      "agent-wash":   { "$type": "color", "$value": "{primitive.color.indigo.wash-light}" }
    }
  },

  "component": {
    "$description": "Tier 3 — per-component bindings. Distinct-per-surface uses the SAME semantic tokens; only projection/measure/serif-emphasis differ (config, not a fork).",
    "focusring": {
      "color": { "$type": "color", "$value": "{semantic.color.focus}" },
      "width": { "$type": "dimension", "$value": "2px" },
      "offset":{ "$type": "dimension", "$value": "2px" }
    },
    "button-primary": {
      "bg":   { "$type": "color", "$value": "{semantic.color.accent}" },
      "text": { "$type": "color", "$value": "{semantic.color.on-accent}" },
      "radius":{ "$type": "dimension", "$value": "{primitive.radius.md}" }
    },
    "chip": {
      "$description": "the ONE reference chip — invariant across every surface",
      "bg":     { "$type": "color", "$value": "{semantic.color.surface-raise}" },
      "border": { "$type": "color", "$value": "{semantic.color.line-strong}" },
      "radius": { "$type": "dimension", "$value": "{primitive.radius.sm}" }
    },
    "agent-mark": {
      "color": { "$type": "color", "$value": "{semantic.color.agent}" },
      "bg":    { "$type": "color", "$value": "{semantic.color.agent-wash}" }
    },
    "editor": {
      "measure":   { "$type": "dimension", "$value": "{primitive.dimension.measure}" },
      "body-font": { "$type": "fontFamily", "$value": "{primitive.font.serif}" }
    },
    "diff": {
      "add-bg":    { "$type": "color", "$value": "#EAF1E5" },
      "del-bg":    { "$type": "color", "$value": "#F7E9E4" },
      "gutter":    { "$type": "color", "$value": "{semantic.color.text-3}" },
      "code-font": { "$type": "fontFamily", "$value": "{primitive.font.mono}" }
    }
  }
}
