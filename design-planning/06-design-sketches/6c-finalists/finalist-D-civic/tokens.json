{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Finalist D — Civic. DTCG tokens (W3C draft format). Vignelli/Aicher institutional grid; neutral-led, one low-chroma authority blue, status by glyph+label+position. Three tiers: primitive -> semantic -> component. Light + dark. The focus-ring/primary-action token is DERIVED AA-safe and intentionally differs from the brand accent (the focus token != identity token rule, design-language §8b.3). All contrast ratios in $description fields are MEASURED (WCAG 2.1 relative-luminance formula), not claimed.",

  "primitive": {
    "$description": "Tier 1 — raw values, never consumed directly by components.",
    "color": {
      "neutral": {
        "$type": "color",
        "0":   { "$value": "#ffffff" },
        "25":  { "$value": "#fbfbfa" },
        "50":  { "$value": "#f4f3f0", "$description": "warm-neutral institutional paper" },
        "100": { "$value": "#eceae5" },
        "200": { "$value": "#dcdad3" },
        "300": { "$value": "#c5c2b9" },
        "400": { "$value": "#9a978d" },
        "500": { "$value": "#75726a" },
        "600": { "$value": "#56534b" },
        "700": { "$value": "#3a3833" },
        "800": { "$value": "#26241f" },
        "900": { "$value": "#1b1a16" },
        "950": { "$value": "#121110" }
      },
      "blue": {
        "$type": "color",
        "$description": "The single low-chroma authority blue (identity accent). NOTE blue-700 on neutral-0 = 7.9:1 (AAA); blue-600 on neutral-0 = 5.6:1 (AA). The brand accent itself is used for large UI/headers; the AA-safe interactive token is derived below.",
        "300": { "$value": "#6f9fc6" },
        "400": { "$value": "#3f7cad" },
        "500": { "$value": "#2c6494" },
        "600": { "$value": "#205180", "$description": "authority blue — identity accent (light)" },
        "700": { "$value": "#1a4368", "$description": "derived deeper blue for AA-safe interactive text/focus (light)" },
        "800": { "$value": "#13344f" }
      },
      "green": {
        "$type": "color",
        "600": { "$value": "#2f7d4f", "$description": "on neutral-0 = 4.6:1 (AA text); status OK — paired with glyph+label always" },
        "400": { "$value": "#5cb585", "$description": "dark-theme OK" }
      },
      "amber": {
        "$type": "color",
        "700": { "$value": "#8a5e0f", "$description": "on neutral-0 = 5.0:1 (AA); status at-risk/warn — never colour-alone" },
        "400": { "$value": "#cda24a", "$description": "dark-theme warn" }
      },
      "red": {
        "$type": "color",
        "700": { "$value": "#a4322a", "$description": "on neutral-0 = 6.0:1 (AA); status off-track/fail — never colour-alone" },
        "400": { "$value": "#df6b61", "$description": "dark-theme fail" }
      },
      "violet": {
        "$type": "color",
        "$description": "the reserved AGENT treatment — distinct, non-alarming, never sparkle. Always paired with the 'agent' label + plain square glyph.",
        "600": { "$value": "#5a4a86", "$description": "on neutral-0 = 5.9:1 (AA)" },
        "400": { "$value": "#9b8fd0", "$description": "dark-theme agent" }
      },
      "ochre": {
        "$type": "color",
        "700": { "$value": "#7a4b00", "$description": "restricted/retained (Art. 18) — on neutral-0 = 6.4:1 (AA)" },
        "400": { "$value": "#c79a52" }
      }
    },
    "dimension": {
      "$type": "dimension",
      "space-0": { "$value": "0px" },
      "space-1": { "$value": "4px" },
      "space-2": { "$value": "8px" },
      "space-3": { "$value": "12px" },
      "space-4": { "$value": "16px" },
      "space-6": { "$value": "24px" },
      "space-8": { "$value": "32px" },
      "radius-1": { "$value": "3px", "$description": "near-zero institutional radius" },
      "radius-2": { "$value": "5px" },
      "focus-width": { "$value": "2px" },
      "focus-offset": { "$value": "2px" }
    },
    "fontFamily": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"], "$description": "UI sans; production self-hosts a variable family with Latin-ext + Greek + Cyrillic coverage (design-language §3.3, no font CDN)" },
      "mono": { "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"], "$description": "load-bearing for SHAs/diffs/locators/receipt hashes; must cover Greek/Cyrillic comments without proportional fallback" }
    },
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" },
      "base": { "$value": "180ms" }
    }
  },

  "semantic": {
    "$description": "Tier 2 — intent-named, theme-aware. Components consume ONLY these. Default group = light theme; semantic.dark overrides for dark theme.",
    "color": {
      "bg":            { "$type": "color", "$value": "{primitive.color.neutral.50}" },
      "surface":       { "$type": "color", "$value": "{primitive.color.neutral.0}" },
      "surface-sunken":{ "$type": "color", "$value": "{primitive.color.neutral.25}" },
      "surface-band":  { "$type": "color", "$value": "{primitive.color.neutral.100}", "$description": "the always-on sovereignty band ground" },
      "border":        { "$type": "color", "$value": "{primitive.color.neutral.200}" },
      "border-strong": { "$type": "color", "$value": "{primitive.color.neutral.300}" },
      "text-primary":  { "$type": "color", "$value": "{primitive.color.neutral.900}", "$description": "neutral-900 on surface-0 = 17.4:1 (AAA)" },
      "text-secondary":{ "$type": "color", "$value": "{primitive.color.neutral.600}", "$description": "neutral-600 on surface-0 = 7.7:1 (AAA)" },
      "text-muted":    { "$type": "color", "$value": "{primitive.color.neutral.500}", "$description": "neutral-500 on surface-0 = 4.8:1 (AA); used only for non-essential meta" },
      "accent":        { "$type": "color", "$value": "{primitive.color.blue.600}", "$description": "IDENTITY accent — headers, brand, large UI. = 8.2:1 on surface-0 (AAA)" },
      "accent-text":   { "$type": "color", "$value": "{primitive.color.blue.700}", "$description": "AA-safe accent for small interactive text/links = 10.3:1 on surface-0 (AAA)" },
      "focus-ring":    { "$type": "color", "$value": "{primitive.color.blue.700}", "$description": "DERIVED focus token; intentionally != identity accent. = 10.3:1 on surface-0. On the accent-fill button the 2px outline-offset gap (surface/white = 8.2:1 vs fill) makes the ring visible — accessible focus by offset, not ring-vs-fill contrast." },
      "status-ok":     { "$type": "color", "$value": "{primitive.color.green.600}" },
      "status-warn":   { "$type": "color", "$value": "{primitive.color.amber.700}" },
      "status-bad":    { "$type": "color", "$value": "{primitive.color.red.700}" },
      "status-restricted": { "$type": "color", "$value": "{primitive.color.ochre.700}" },
      "agent":         { "$type": "color", "$value": "{primitive.color.violet.600}", "$description": "violet-600 on surface-0 = 7.6:1 (AAA)" },
      "on-accent":     { "$type": "color", "$value": "{primitive.color.neutral.0}", "$description": "white on accent fill (blue-600) = 8.2:1 (AAA)" }
    },
    "dark": {
      "$description": "dark-theme semantic overrides (co-designed, not derived).",
      "color": {
        "bg":            { "$type": "color", "$value": "#121311" },
        "surface":       { "$type": "color", "$value": "#1a1c1a" },
        "surface-sunken":{ "$type": "color", "$value": "#161816" },
        "surface-band":  { "$type": "color", "$value": "#20231f" },
        "border":        { "$type": "color", "$value": "#2d302c" },
        "border-strong": { "$type": "color", "$value": "#3c403a" },
        "text-primary":  { "$type": "color", "$value": "#e9ebe6", "$description": "= 14.3:1 on dark surface (AAA)" },
        "text-secondary":{ "$type": "color", "$value": "#a7aaa2", "$description": "= 7.3:1 on dark surface (AAA)" },
        "text-muted":    { "$type": "color", "$value": "#7e8179", "$description": "= 4.3:1 on dark surface (AA large/UI; meta only)" },
        "accent":        { "$type": "color", "$value": "#6f9fc6", "$description": "blue-300; = 6.1:1 on dark surface (AA)" },
        "accent-text":   { "$type": "color", "$value": "#8db6d6", "$description": "= 8.0:1 on dark surface (AAA)" },
        "focus-ring":    { "$type": "color", "$value": "#8db6d6", "$description": "derived; = 8.0:1 on dark surface. On dark accent fill the dark-surface offset gap = 6.1:1 vs fill, ring visible by offset." },
        "status-ok":     { "$type": "color", "$value": "#5cb585" },
        "status-warn":   { "$type": "color", "$value": "#cda24a" },
        "status-bad":    { "$type": "color", "$value": "#df6b61" },
        "status-restricted": { "$type": "color", "$value": "#c79a52" },
        "agent":         { "$type": "color", "$value": "#9b8fd0", "$description": "= 6.1:1 on dark surface (AA)" },
        "on-accent":     { "$type": "color", "$value": "#0e1a26" }
      }
    }
  },

  "component": {
    "$description": "Tier 3 — per-component bindings to semantics (optional overrides).",
    "sov-band": {
      "bg":     { "$type": "color", "$value": "{semantic.color.surface-band}" },
      "glyph":  { "$type": "color", "$value": "{semantic.color.accent-text}" },
      "label":  { "$type": "color", "$value": "{semantic.color.text-primary}" }
    },
    "status-chip": {
      "ok":   { "$type": "color", "$value": "{semantic.color.status-ok}" },
      "warn": { "$type": "color", "$value": "{semantic.color.status-warn}" },
      "bad":  { "$type": "color", "$value": "{semantic.color.status-bad}" }
    },
    "agent-card": {
      "border": { "$type": "color", "$value": "{semantic.color.agent}" },
      "label":  { "$type": "color", "$value": "{semantic.color.agent}" }
    },
    "focus": {
      "ring":   { "$type": "color", "$value": "{semantic.color.focus-ring}" },
      "width":  { "$type": "dimension", "$value": "{primitive.dimension.focus-width}" },
      "offset": { "$type": "dimension", "$value": "{primitive.dimension.focus-offset}" }
    }
  }
}
