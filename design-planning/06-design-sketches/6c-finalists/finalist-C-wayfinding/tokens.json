{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Finalist C — Wayfinding (Spiekermann signage lineage). DTCG W3C format. Three tiers: primitive -> semantic -> component. Light + dark. Neutral-led, ONE rationed wayfinding accent (orange). Focus/primary-action token is DERIVED AA-safe and is NOT the brand accent (focus token != identity token, design-language §8b.3). Status is never colour-alone: tokens pair with glyph+label+position in the markup. All contrast pairs measured with the WCAG 2.1 relative-luminance formula (see README §G1).",

  "color": {
    "$type": "color",
    "primitive": {
      "$description": "Tier 1 — raw palette. Cool functional grey ramp (signage clarity), one wayfinding orange, topic blue, agent indigo, functional status hues. Never pure #fff / #000.",
      "grey": {
        "0":  { "$value": "#0e1116" },
        "1":  { "$value": "#141821" },
        "2":  { "$value": "#1b2029" },
        "3":  { "$value": "#222936" },
        "4":  { "$value": "#2e3644" },
        "5":  { "$value": "#3c4556" },
        "6":  { "$value": "#586273" },
        "7":  { "$value": "#79839a" },
        "8":  { "$value": "#9aa3b6" },
        "9":  { "$value": "#c2c9d6" },
        "10": { "$value": "#e3e7ef" },
        "11": { "$value": "#f4f6fa" }
      },
      "paper": {
        "$description": "Light surfaces — warm-neutral off-white, never #fff.",
        "0":  { "$value": "#ffffff" },
        "50": { "$value": "#f7f8fb" },
        "100":{ "$value": "#eef1f6" },
        "150":{ "$value": "#e2e6ee" },
        "200":{ "$value": "#cdd4e0" },
        "ink-0": { "$value": "#1a1f29" },
        "ink-1": { "$value": "#3b4452" },
        "ink-2": { "$value": "#5b6675" },
        "ink-3": { "$value": "#717c8c" }
      },
      "orange": {
        "$description": "The ONE wayfinding accent — addresses, unread, the live thing. Rationed.",
        "bright": { "$value": "#e0732a" },
        "deep":   { "$value": "#b85410" },
        "ink-on": { "$value": "#1a1206" }
      },
      "topic": {
        "$description": "Topic-thread token, cool blue (not alarming, distinct from accent + focus).",
        "dark":  { "$value": "#7fa8d8" },
        "light": { "$value": "#2c5d99" }
      },
      "agent": {
        "$description": "Reserved agent identity hue — indigo, non-alarming, NOT a status colour.",
        "dark":      { "$value": "#9aa9e0" },
        "dark-line": { "$value": "#414e7a" },
        "dark-bg":   { "$value": "#1a2236" },
        "light":     { "$value": "#4a4fb0" },
        "light-bg":  { "$value": "#ecedf8" },
        "light-line":{ "$value": "#c6c9ee" }
      },
      "blue": {
        "$description": "AA-safe blue used to DERIVE the focus token — chosen for contrast, not identity.",
        "dark":  { "$value": "#6fb0ec" },
        "light": { "$value": "#1d6fb8" }
      },
      "ok":   { "dark": { "$value": "#5fae72" }, "light": { "$value": "#1f7a43" } },
      "warn": { "dark": { "$value": "#d6ad44" }, "light": { "$value": "#8a6209" } },
      "crit": { "dark": { "$value": "#e0786a" }, "light": { "$value": "#b3382a" } }
    },

    "semantic": {
      "$description": "Tier 2 — role-mapped. Each mode (light/dark) maps roles to primitives. The screens consume ONLY semantic/component vars.",
      "dark": {
        "bg":        { "$value": "{color.primitive.grey.0}" },
        "panel":     { "$value": "{color.primitive.grey.1}" },
        "panel-2":   { "$value": "{color.primitive.grey.2}" },
        "line":      { "$value": "{color.primitive.grey.3}" },
        "line-2":    { "$value": "{color.primitive.grey.5}" },
        "ink":       { "$value": "{color.primitive.grey.11}" },
        "ink-2":     { "$value": "{color.primitive.grey.9}" },
        "ink-3":     { "$value": "{color.primitive.grey.7}" },
        "accent":    { "$value": "{color.primitive.orange.bright}" },
        "accent-ink":{ "$value": "{color.primitive.orange.ink-on}" },
        "topic":     { "$value": "{color.primitive.topic.dark}" },
        "agent":     { "$value": "{color.primitive.agent.dark}" },
        "agent-line":{ "$value": "{color.primitive.agent.dark-line}" },
        "agent-bg":  { "$value": "{color.primitive.agent.dark-bg}" },
        "ok":        { "$value": "{color.primitive.ok.dark}" },
        "warn":      { "$value": "{color.primitive.warn.dark}" },
        "crit":      { "$value": "{color.primitive.crit.dark}" },
        "focus":     { "$value": "{color.primitive.blue.dark}", "$description": "DERIVED AA-safe focus ring; NOT the accent (orange). 3:1+ on dark surfaces." }
      },
      "light": {
        "bg":        { "$value": "{color.primitive.paper.50}" },
        "panel":     { "$value": "{color.primitive.paper.0}" },
        "panel-2":   { "$value": "{color.primitive.paper.100}" },
        "line":      { "$value": "{color.primitive.paper.150}" },
        "line-2":    { "$value": "{color.primitive.paper.200}" },
        "ink":       { "$value": "{color.primitive.paper.ink-0}" },
        "ink-2":     { "$value": "{color.primitive.paper.ink-1}" },
        "ink-3":     { "$value": "{color.primitive.paper.ink-2}" },
        "accent":    { "$value": "{color.primitive.orange.deep}" },
        "accent-ink":{ "$value": "{color.primitive.paper.0}" },
        "topic":     { "$value": "{color.primitive.topic.light}" },
        "agent":     { "$value": "{color.primitive.agent.light}" },
        "agent-line":{ "$value": "{color.primitive.agent.light-line}" },
        "agent-bg":  { "$value": "{color.primitive.agent.light-bg}" },
        "ok":        { "$value": "{color.primitive.ok.light}" },
        "warn":      { "$value": "{color.primitive.warn.light}" },
        "crit":      { "$value": "{color.primitive.crit.light}" },
        "focus":     { "$value": "{color.primitive.blue.light}", "$description": "DERIVED AA-safe focus ring; NOT the accent. 3:1+ on light surfaces." }
      }
    },

    "component": {
      "$description": "Tier 3 — component-scoped. Reference semantic roles; one place to retune a part.",
      "primary-action-bg":  { "$value": "{color.semantic.dark.accent}" },
      "primary-action-ink": { "$value": "{color.semantic.dark.accent-ink}" },
      "gate-marker":        { "$value": "{color.semantic.dark.warn}" },
      "address-token":      { "$value": "{color.semantic.dark.accent}", "$description": "channel▸topic platform-number address token." },
      "agent-badge-bg":     { "$value": "{color.semantic.dark.agent-bg}" },
      "agent-badge-fg":     { "$value": "{color.semantic.dark.agent}" }
    }
  },

  "dimension": {
    "$type": "dimension",
    "space": {
      "$description": "4/8 ramp.",
      "0": { "$value": "0px" },
      "1": { "$value": "4px" },
      "2": { "$value": "8px" },
      "3": { "$value": "12px" },
      "4": { "$value": "16px" },
      "5": { "$value": "24px" },
      "6": { "$value": "32px" },
      "7": { "$value": "48px" }
    },
    "radius": {
      "sm": { "$value": "3px" },
      "md": { "$value": "4px" },
      "lg": { "$value": "8px" },
      "pill": { "$value": "999px" }
    },
    "focus-ring": { "$value": "2px", "$description": "Focus outline width; offset 2px (set in CSS)." },
    "address-bar": { "$value": "2px", "$description": "Inset shadow width of the wayfinding address marker." }
  },

  "typography": {
    "font-family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Archivo", "system-ui", "sans-serif"], "$description": "Functional grotesk (signage). Production self-hosts; carries Latin-ext + Greek + Cyrillic." },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "monospace"], "$description": "Addresses, refs, code, SHAs, log lines." }
    },
    "font-size": {
      "$type": "dimension",
      "xs": { "$value": "11px" },
      "sm": { "$value": "12.5px" },
      "md": { "$value": "14px" },
      "lg": { "$value": "15px" },
      "xl": { "$value": "18px" }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.35, "$description": "Min line-height with diacritic headroom (Greek tonos, Cyrillic breve) — never 1.0." },
      "body":  { "$value": 1.5 }
    }
  },

  "duration": {
    "$type": "duration",
    "fast":   { "$value": "120ms", "$description": "Functional, interruptible. Reduced-motion path zeroes these." },
    "agent-enter": { "$value": "180ms" }
  }
}
