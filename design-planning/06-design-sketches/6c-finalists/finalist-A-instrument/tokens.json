{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Finalist A — 'Instrument' (Phase 6c). W3C DTCG-format token set. Three tiers: primitive -> semantic -> component. Light + dark themes. The focus/primary-action token is DERIVED AA-safe and is a DISTINCT token from the identity accent (design-language §8b.3, R-17 audit-method §3.2). Neutral-led, one rationed accent. Measured contrast ratios are recorded in the README and as $description on the focus token.",
  "primitive": {
    "$description": "Tier 1 — raw values, no meaning attached. Two neutral ramps (dark/light) + functional hues + scales.",
    "color": {
      "$type": "color",
      "neutral-dark": {
        "0":  { "$value": "#0c0d10", "$description": "app base, dark" },
        "1":  { "$value": "#101116" },
        "2":  { "$value": "#16181d" },
        "3":  { "$value": "#1d2026" },
        "4":  { "$value": "#24272f", "$description": "hairline border, dark" },
        "5":  { "$value": "#2e323b" },
        "6":  { "$value": "#3a3f47" },
        "txt-3": { "$value": "#868d99", "$description": "tertiary text, dark — 5.81:1 on n0" },
        "txt-2": { "$value": "#aeb3be", "$description": "secondary text, dark — 9.25:1 on n0" },
        "txt-1": { "$value": "#e7e9ee", "$description": "primary text, dark — 16.00:1 on n0" }
      },
      "neutral-light": {
        "0":  { "$value": "#ffffff", "$description": "app base, light" },
        "1":  { "$value": "#f7f8fa" },
        "2":  { "$value": "#eef0f3" },
        "3":  { "$value": "#e3e6ea", "$description": "hairline border, light" },
        "4":  { "$value": "#d4d8de" },
        "5":  { "$value": "#b9bfc8" },
        "6":  { "$value": "#9aa1ac" },
        "txt-3": { "$value": "#646b78", "$description": "tertiary text, light — 5.36:1 on n0" },
        "txt-2": { "$value": "#4a505b", "$description": "secondary text, light — 8.11:1 on n0" },
        "txt-1": { "$value": "#15171c", "$description": "primary text, light — 17.93:1 on n0" }
      },
      "blue": {
        "$description": "the ONE rationed accent family + its AA-derived focus/action steps",
        "identity-dark":  { "$value": "#5b8cff", "$description": "identity accent, dark — 6.14:1 on n0" },
        "identity-light": { "$value": "#2f6bff", "$description": "identity accent, light — 4.50:1 on n0" },
        "focus-dark":     { "$value": "#7ea6ff", "$description": "DERIVED focus/action, dark — 8.13:1 on n0 (>= accent, distinct token)" },
        "focus-light":    { "$value": "#1452d6", "$description": "DERIVED focus/action, light — 6.55:1 on n0; white-on-it 6.55:1" },
        "weak-dark":      { "$value": "#172238" },
        "weak-light":     { "$value": "#e7eeff" }
      },
      "green": { "dark": { "$value": "#46b277" }, "light": { "$value": "#15794a" } },
      "amber": { "dark": { "$value": "#d6a93f" }, "light": { "$value": "#8a5a07" } },
      "red":   { "dark": { "$value": "#e0695c" }, "light": { "$value": "#c0392b" } },
      "violet":{ "dark": { "$value": "#a99bf2", "$description": "reserved AGENT family, dark — non-status, 8.01:1 on n0" },
                 "light": { "$value": "#5b4ec9", "$description": "reserved AGENT family, light — 6.22:1 on n0" } },
      "diff": {
        "add-bg-dark": { "$value": "#10231a" }, "add-bg-light": { "$value": "#e3f5ea" },
        "del-bg-dark": { "$value": "#27151a" }, "del-bg-light": { "$value": "#fbe6e6" },
        "add-txt-dark": { "$value": "#74d39b", "$description": "9.03:1 on add-bg-dark" },
        "del-txt-dark": { "$value": "#f2897e", "$description": "7.16:1 on del-bg-dark" },
        "add-txt-light": { "$value": "#0d6b3e", "$description": "5.80:1 on add-bg-light" },
        "del-txt-light": { "$value": "#a32f25", "$description": "5.87:1 on del-bg-light" }
      }
    },
    "dimension": {
      "$type": "dimension",
      "$description": "4/8 spacing ramp + radii (near-zero) — Instrument is compact-default",
      "space-1": { "$value": "4px" },
      "space-2": { "$value": "8px" },
      "space-3": { "$value": "12px" },
      "space-4": { "$value": "16px" },
      "space-5": { "$value": "24px" },
      "space-6": { "$value": "32px" },
      "radius-0": { "$value": "0px" },
      "radius-1": { "$value": "3px", "$description": "near-zero default" },
      "radius-2": { "$value": "6px" },
      "radius-pill": { "$value": "999px" },
      "hairline": { "$value": "1px" },
      "target-min": { "$value": "24px", "$description": "WCAG 2.2 SC 2.5.8 minimum target" }
    },
    "duration": {
      "$type": "duration",
      "$description": "functional/fast; reduced-motion path zeroes these",
      "instant": { "$value": "0ms" },
      "fast": { "$value": "90ms" },
      "base": { "$value": "150ms" }
    },
    "fontFamily": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "-apple-system", "system-ui", "Segoe UI", "sans-serif"], "$description": "self-hosted in prod; must carry Latin-ext + Greek + Cyrillic (R-18 §3.1)" },
      "mono": { "$value": ["JetBrains Mono", "SF Mono", "ui-monospace", "Cascadia Mono", "monospace"], "$description": "load-bearing & native; Greek/Cyrillic comment coverage required" }
    },
    "fontWeight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 }
    },
    "lineHeight": {
      "$type": "number",
      "body": { "$value": 1.45, "$description": ">=1.45 for diacritic headroom (R-18 §3.2; never 1.0)" },
      "tight": { "$value": 1.3 }
    }
  },

  "semantic": {
    "$description": "Tier 2 — meaning, theme-aware. Screens consume these via CSS vars; theme swap repoints the alias.",
    "color": {
      "$type": "color",
      "surface-base":   { "$value": "{primitive.color.neutral-dark.0}" },
      "surface-raised": { "$value": "{primitive.color.neutral-dark.1}" },
      "surface-sunken": { "$value": "{primitive.color.neutral-dark.2}" },
      "surface-hover":  { "$value": "{primitive.color.neutral-dark.3}" },
      "border":         { "$value": "{primitive.color.neutral-dark.4}", "$description": "hairlines do ALL grouping — borders over shadow" },
      "border-strong":  { "$value": "{primitive.color.neutral-dark.6}" },
      "text-primary":   { "$value": "{primitive.color.neutral-dark.txt-1}" },
      "text-secondary": { "$value": "{primitive.color.neutral-dark.txt-2}" },
      "text-tertiary":  { "$value": "{primitive.color.neutral-dark.txt-3}" },
      "accent":         { "$value": "{primitive.color.blue.identity-dark}", "$description": "IDENTITY only — never the sole carrier of focus" },
      "focus":          { "$value": "{primitive.color.blue.focus-dark}", "$description": "DERIVED, AA-safe, DISTINCT from accent — the one focus-ring/primary token. Dark: 8.13:1 on base (>=3:1 UI floor met everywhere)." },
      "on-focus":       { "$value": "{primitive.color.neutral-dark.0}", "$description": "text on a focus/primary fill" },
      "status-ok":      { "$value": "{primitive.color.green.dark}" },
      "status-warn":    { "$value": "{primitive.color.amber.dark}" },
      "status-bad":     { "$value": "{primitive.color.red.dark}" },
      "agent":          { "$value": "{primitive.color.violet.dark}", "$description": "reserved agent token — NOT a status colour; always paired with label + plain geometric mark" }
    }
  },

  "component": {
    "$description": "Tier 3 — per-component bindings that resolve to semantic. Shows components are tuned, not forked.",
    "color": {
      "$type": "color",
      "button-primary-bg":   { "$value": "{semantic.color.focus}", "$description": "primary action rides the DERIVED token, not the identity accent" },
      "button-primary-text": { "$value": "{semantic.color.on-focus}" },
      "focus-ring":          { "$value": "{semantic.color.focus}", "$description": "ONE focus-ring token across palette row / diff line / board card / editor block / HITL button / overlay control" },
      "chip-border":         { "$value": "{semantic.color.border}" },
      "agent-mark":          { "$value": "{semantic.color.agent}" },
      "diff-add-bg":         { "$value": "{primitive.color.diff.add-bg-dark}" },
      "diff-del-bg":         { "$value": "{primitive.color.diff.del-bg-dark}" },
      "rail-active-accent":  { "$value": "{semantic.color.accent}", "$description": "identity accent used as a 2px inset marker, paired with weight/colour, never alone" }
    },
    "dimension": {
      "$type": "dimension",
      "control-height":  { "$value": "28px" },
      "row-height":      { "$value": "32px" },
      "radius":          { "$value": "{primitive.dimension.radius-1}" }
    }
  }
}
