# Myelin frontend workspace — deterministic, self-hosted, minimal-surprise installs.
# Peers are auto-installed but a missing peer is a warning, not a hard failure, so the
# SD/eslint/axe toolchain (the sanctioned exception to the minimal-deps ethos) resolves cleanly.
auto-install-peers=true
strict-peer-dependencies=false
# No engine hard-fail: node 24 / pnpm 10 are the verified baseline but CI images vary.
engine-strict=false
# Self-hosted ethos: never reach for a CDN at build time for tokens/icons (they live in-repo).
