{
  "name": "@myelin/frontend",
  "version": "0.0.0",
  "private": true,
  "description": "Myelin web, desktop, and shared design-system workspace.",
  "type": "module",
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:browser-integration": "pnpm --filter @myelin/web test:browser-integration",
    "test:e2e": "pnpm --filter @myelin/web test:e2e"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mh99-v99m-4gvg"
      ]
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-solid": "^0.14.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  }
}
