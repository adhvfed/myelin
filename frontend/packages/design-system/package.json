{
  "name": "@myelin/design-system",
  "version": "0.0.0",
  "private": true,
  "description": "Myelin Solid design-system (Tier 0 wired): tokens.css + TS constants generated by Style Dictionary from the canonical DTCG tokens.json, the self-hosted strok icon sprite + a Solid <Icon>, and a token-only demo. No primitives here (those are MR-017).",
  "type": "module",
  "sideEffects": ["*.css"],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./generated/tokens.css",
    "./tokens": "./generated/tokens.ts",
    "./sprite.svg": "./generated/assets/sprite.svg"
  },
  "files": [
    "src",
    "generated"
  ],
  "scripts": {
    "build:tokens": "node build-tokens.mjs",
    "build:assets": "node scripts/copy-assets.mjs",
    "build:verify": "node scripts/verify-tokens.mjs",
    "build": "pnpm build:tokens && pnpm build:assets && pnpm build:verify && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src styleguide build-tokens.mjs scripts",
    "lint:prove": "eslint fixtures/red",
    "test": "vitest run"
  },
  "dependencies": {
    "solid-js": "^1.9.4"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.6.3",
    "jsdom": "^25.0.1",
    "style-dictionary": "^4.3.0",
    "vite": "^5.4.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^2.1.8",
    "vitest-axe": "^0.1.0"
  }
}
